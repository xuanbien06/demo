@model IEnumerable<FaceAttendance.Web.Models.ClassRoom>
@{
    ViewData["Title"] = "Điểm Danh Bằng Camera";
}

<div class="row mb-3">
    <div class="col-md-12">
        <div class="card shadow-sm border-0 bg-white">
            <div class="card-body d-flex justify-content-between align-items-center">

                <div class="d-flex align-items-center gap-3 w-50">
                    <label class="fw-bold mb-0 text-nowrap"><i class="fa-solid fa-chalkboard-user text-primary"></i> Chọn lớp:</label>
                    <select id="classSelector" class="form-select border-primary shadow-sm">
                        <option value="" selected>-- Vui lòng chọn lớp để điểm danh --</option>
                        @if (Model != null)
                        {
                            foreach (var c in Model)
                            {
                                <option value="@c.ClassID">@c.ClassName</option>
                            }
                        }
                    </select>
                </div>

                <div class="text-end border-start ps-4">
                    <h4 class="text-primary mb-1 fw-bold" id="lblCurrentClass">Lớp: <span class="text-danger">Chưa chọn</span></h4>
                    <span class="text-muted fw-bold"><i class="fa-solid fa-calendar-day"></i> Ngày: @DateTime.Now.ToString("dd/MM/yyyy")</span>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="m-0"><i class="fa-solid fa-video text-danger"></i> Màn hình Camera</h5>
                <div>
                    <button id="btnStartCamera" class="btn btn-success fw-bold"><i class="fa-solid fa-play"></i> BẮT ĐẦU ĐIỂM DANH</button>
                    <button id="btnEndCamera" class="btn btn-danger fw-bold d-none"><i class="fa-solid fa-stop"></i> KẾT THÚC & LƯU KẾT QUẢ</button>
                </div>
            </div>
            <div class="card-body text-center bg-light" style="position: relative; padding: 0;">
                <video id="videoElement" autoplay playsinline style="display: none;"></video>
                <canvas id="displayCanvas" style="width: 100%; max-height: 480px; border-radius: 8px; background: #000;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm h-100">
            <div class="card-header bg-primary text-white">
                <h5 class="m-0"><i class="fa-solid fa-list-check"></i> Lịch sử nhận diện</h5>
            </div>
            <div class="card-body" id="attendanceResults" style="overflow-y: auto; max-height: 480px;">
                <p class="text-muted fst-italic">Đang chờ hệ thống AI...</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const classSelector = document.getElementById('classSelector');
        const lblCurrentClass = document.getElementById('lblCurrentClass');
        const video = document.getElementById('videoElement');
        const displayCanvas = document.getElementById('displayCanvas');
        const displayCtx = displayCanvas.getContext('2d');
        const btnStart = document.getElementById('btnStartCamera');
        const resultsDiv = document.getElementById('attendanceResults');

        let isRunning = false;
        let trackedFaces = new Map();
        let recognizedStudents = new Set();

        // 1. Thay đổi text Tên Lớp khi user chọn Combobox
        classSelector.addEventListener('change', function() {
            if (this.value) {
                lblCurrentClass.innerHTML = `Lớp: <span class="text-success">${this.options[this.selectedIndex].text}</span>`;
            } else {
                lblCurrentClass.innerHTML = `Lớp: <span class="text-danger">Chưa chọn</span>`;
            }
        });

        function lerp(start, end, amt) {
            return (1 - amt) * start + amt * end;
        }

        // 2. YÊU CẦU 7: Validate trước khi mở Camera
        btnStart.addEventListener('click', async () => {
            if(isRunning) return;

            // Bắt buộc chọn lớp
            if (!classSelector.value) {
                alert("⚠ VUI LÒNG CHỌN LỚP TRƯỚC KHI BẬT CAMERA ĐIỂM DANH!");
                classSelector.focus();
                return;
            }

            try {
                const stream = await navigator.mediaDevices.getUserMedia({ video: { width: 640, height: 480 } });
                video.srcObject = stream;

                video.onloadedmetadata = () => {
                    displayCanvas.width = video.videoWidth;
                    displayCanvas.height = video.videoHeight;
                };

                // Khóa Dropdown không cho đổi lớp khi đang điểm danh
                classSelector.disabled = true;

                btnStart.innerHTML = "<i class='fa-solid fa-spinner fa-spin'></i> ĐANG QUÉT KHUÔN MẶT...";
                btnStart.classList.replace('btn-success', 'btn-warning');
                btnStart.disabled = true;
                resultsDiv.innerHTML = "";

                isRunning = true;
                // Hiển thị nút kết thúc
                btnStart.classList.add('d-none');
                document.getElementById('btnEndCamera').classList.remove('d-none');
                requestAnimationFrame(drawLoop);
                sendFrameToAI();

            } catch (err) {
                alert("Lỗi không thể mở Camera: " + err.message);
            }
        });

        // ----------------------------------------------------
        // VẼ GIAO DIỆN (60 FPS)
        // ----------------------------------------------------
        function drawLoop() {
            if (!isRunning) return;

            displayCtx.save();
            displayCtx.translate(displayCanvas.width, 0);
            displayCtx.scale(-1, 1);
            displayCtx.drawImage(video, 0, 0, displayCanvas.width, displayCanvas.height);
            displayCtx.restore();

            const now = Date.now();
            for (let [id, face] of trackedFaces.entries()) {
                if (now - face.lastSeen > 1000) {
                    trackedFaces.delete(id);
                    continue;
                }

                const smoothFactor = 0.15;
                face.currentBox[0] = lerp(face.currentBox[0], face.targetBox[0], smoothFactor);
                face.currentBox[1] = lerp(face.currentBox[1], face.targetBox[1], smoothFactor);
                face.currentBox[2] = lerp(face.currentBox[2], face.targetBox[2], smoothFactor);
                face.currentBox[3] = lerp(face.currentBox[3], face.targetBox[3], smoothFactor);

                const cBox = face.currentBox;
                const x = displayCanvas.width - cBox[0] - cBox[2];
                const y = cBox[1];
                const w = cBox[2];
                const h = cBox[3];

                const color = face.success ? "#00FF00" : "#FF0000";
                const displayName = face.studentName;

                displayCtx.beginPath();
                displayCtx.rect(x, y, w, h);
                displayCtx.lineWidth = 3;
                displayCtx.strokeStyle = color;
                displayCtx.stroke();

                displayCtx.fillStyle = color;
                displayCtx.fillRect(x, y - 30, w, 30);

                displayCtx.fillStyle = "#000000";
                displayCtx.font = "bold 16px Arial";
                displayCtx.fillText(displayName, x + 5, y - 8);
            }
            requestAnimationFrame(drawLoop);
        }

        // ----------------------------------------------------
        // GIAO TIẾP VỚI C#
        // ----------------------------------------------------
        async function sendFrameToAI() {
            if (!isRunning) return;

            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = video.videoWidth;
            tempCanvas.height = video.videoHeight;
            tempCanvas.getContext('2d').drawImage(video, 0, 0);
            const base64Image = tempCanvas.toDataURL('image/jpeg', 0.8);

            // Lấy ID lớp đang chọn
            const classId = parseInt(classSelector.value);

            try {
                const response = await fetch('/Attendance/Recognize', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    // YÊU CẦU 8: Truyền ClassId xuống Backend
                    body: JSON.stringify({
                        Base64Image: base64Image,
                        ClassId: classId
                    })
                });

                const result = await response.json();
                const now = Date.now();

                if (result.success && result.faces) {
                    result.faces.forEach(newFace => {
                        let bestMatchId = null;
                        let minDistance = Infinity;

                        for (let [id, tFace] of trackedFaces.entries()) {
                            let cx1 = newFace.box[0] + newFace.box[2] / 2;
                            let cy1 = newFace.box[1] + newFace.box[3] / 2;
                            let cx2 = tFace.targetBox[0] + tFace.targetBox[2] / 2;
                            let cy2 = tFace.targetBox[1] + tFace.targetBox[3] / 2;
                            let dist = Math.hypot(cx1 - cx2, cy1 - cy2);

                            if (dist < minDistance && dist < 250) {
                                minDistance = dist;
                                bestMatchId = id;
                            }
                        }

                        if (bestMatchId) {
                            let tFace = trackedFaces.get(bestMatchId);
                            tFace.targetBox = newFace.box;
                            tFace.studentName = newFace.studentName;
                            tFace.success = newFace.success;
                            tFace.lastSeen = now;
                        } else {
                            let newId = Math.random().toString(36).substring(7);
                            trackedFaces.set(newId, {
                                currentBox: [...newFace.box],
                                targetBox: [...newFace.box],
                                studentName: newFace.studentName,
                                success: newFace.success,
                                lastSeen: now
                            });
                        }

                        if (newFace.success && !recognizedStudents.has(newFace.studentId)) {
                            recognizedStudents.add(newFace.studentId);
                            const logHtml = `
                                <div class="alert alert-success py-2 mb-2 shadow-sm text-start">
                                    <i class="fa-solid fa-check-circle"></i>
                                    <strong>${newFace.studentName}</strong> <br>
                                    <small class="text-muted"><i class="fa-solid fa-clock"></i> ${new Date().toLocaleTimeString()}</small>
                                </div>
                            `;
                            resultsDiv.insertAdjacentHTML('afterbegin', logHtml);

                            if (resultsDiv.children.length > 15) {
                                resultsDiv.removeChild(resultsDiv.lastChild);
                            }
                            // Reset trạng thái sau 5 giây để lỡ sinh viên có đi ra đi vào
                            setTimeout(() => { recognizedStudents.delete(newFace.studentName); }, 5000);
                        }
                    });
                }
            } catch (err) {
                console.error("Lỗi gửi ảnh", err);
            }
            setTimeout(sendFrameToAI, 150);
        }
        // XỬ LÝ YÊU CẦU 9: KẾT THÚC ĐIỂM DANH
        document.getElementById('btnEndCamera').addEventListener('click', async () => {
            if (!confirm('Bạn có chắc chắn muốn kết thúc buổi điểm danh này? Hệ thống sẽ chốt danh sách và tự động gửi Email báo vắng.')) return;

            isRunning = false; // Dừng quét Camera
            document.getElementById('btnEndCamera').innerHTML = "<i class='fa-solid fa-spinner fa-spin'></i> Đang lưu & Gửi Email...";

            const classId = parseInt(classSelector.value);
            // Lấy toàn bộ ID sinh viên đã quét được
            const presentIds = Array.from(recognizedStudents);

            try {
                const response = await fetch('/Attendance/EndSession', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        ClassId: classId,
                        PresentStudentIds: presentIds
                    })
                });

                const result = await response.json();
                if (result.success) {
                    // Chuyển sang trang Kết quả (Yêu cầu 10)
                    window.location.href = '/Attendance/Result/' + result.sessionId;
                }
            } catch (err) {
                alert('Có lỗi xảy ra khi lưu: ' + err.message);
            }
        });
    </script>
}