@{
    Layout = null; // Tắt layout mặc định vì trang đăng nhập đứng độc lập
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng nhập - LXB SmartEdu</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">

    <link href="~/css/auth.css" rel="stylesheet" />
</head>
<body>
    <div class="container-auth" id="container">
        <div class="form-container sign-up-container">
            <form id="registerForm">
                <h1>Tạo Tài Khoản</h1>
                <span class="sub-text">Sử dụng email của bạn để đăng ký</span>

                <input type="text" id="regFullName" placeholder="Họ và tên" required />
                <input type="email" id="regEmail" placeholder="Email" required />

                <div class="password-wrapper">
                    <input type="password" id="regPassword" placeholder="Mật khẩu (Từ 6 ký tự)" required minlength="6" />
                    <i class="fa-solid fa-eye toggle-password" data-target="regPassword"></i>
                </div>

                <div class="password-wrapper">
                    <input type="password" id="regConfirmPassword" placeholder="Xác nhận mật khẩu" required />
                    <i class="fa-solid fa-eye toggle-password" data-target="regConfirmPassword"></i>
                </div>

                <button type="submit" id="btnRegister">
                    <span class="btn-text">Đăng Ký</span>
                    <i class="fa-solid fa-spinner fa-spin d-none loading-icon"></i>
                </button>
            </form>
        </div>

        <div class="form-container sign-in-container">
            <form id="loginForm">
                <h1>Đăng Nhập</h1>
                <span class="sub-text">Sử dụng tài khoản của bạn</span>

                <input type="email" id="loginEmail" placeholder="Email" required />

                <div class="password-wrapper">
                    <input type="password" id="loginPassword" placeholder="Mật khẩu" required />
                    <i class="fa-solid fa-eye toggle-password" data-target="loginPassword"></i>
                </div>

                <div class="form-check text-start w-100 mt-2 mb-2">
                    <input class="form-check-input" type="checkbox" id="rememberMe">
                    <label class="form-check-label text-muted" for="rememberMe" style="font-size: 14px;">Ghi nhớ đăng nhập</label>
                </div>

                <a href="#" class="forgot-password">Quên mật khẩu?</a>

                <button type="submit" id="btnLogin">
                    <span class="btn-text">Đăng Nhập</span>
                    <i class="fa-solid fa-spinner fa-spin d-none loading-icon"></i>
                </button>
            </form>
        </div>

        <div class="overlay-container">
            <div class="overlay">
                <div class="overlay-panel overlay-left">
                    <h1>Chào mừng trở lại!</h1>
                    <p>Để giữ kết nối, vui lòng đăng nhập bằng thông tin cá nhân của bạn</p>
                    <button class="ghost" id="signIn">Đăng Nhập</button>
                </div>
                <div class="overlay-panel overlay-right">
                    <h1>Chào bạn!</h1>
                    <p>Nhập thông tin cá nhân của bạn và bắt đầu hành trình với hệ thống AI</p>
                    <button class="ghost" id="signUp">Đăng Ký</button>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/auth.js"></script>
</body>
</html>