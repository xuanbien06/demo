@model FaceAttendance.Web.Models.Class

@{
    ViewData["Title"] = "Thêm lớp học mới";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Thêm lớp học mới</h4>
        </div>
        <div class="card-body">
            <form asp-action="Create">
                <div class="mb-3">
                    <label asp-for="ClassName" class="form-label fw-bold">Tên lớp học <span class="text-danger">*</span></label>
                    <input asp-for="ClassName" class="form-control" placeholder="Ví dụ: CNTT K17A" autocomplete="off" />
                    <span asp-validation-for="ClassName" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-success">Lưu lớp học</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}