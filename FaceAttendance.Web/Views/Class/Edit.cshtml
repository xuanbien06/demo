@model FaceAttendance.Web.Models.ClassRoom

@{
    ViewData["Title"] = "Sửa lớp học";
}

<div class="container mt-4" style="max-width: 600px;">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h4 class="mb-0">Chỉnh sửa thông tin lớp</h4>
        </div>
        <div class="card-body">
            <form asp-action="Edit">
                <input type="hidden" asp-for="ClassID" />
                <input type="hidden" asp-for="CreatedAt" />

                <div class="mb-3">
                    <label asp-for="ClassName" class="form-label fw-bold">Tên lớp học <span class="text-danger">*</span></label>
                    <input asp-for="ClassName" class="form-control" autocomplete="off" />
                    <span asp-validation-for="ClassName" class="text-danger small"></span>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}